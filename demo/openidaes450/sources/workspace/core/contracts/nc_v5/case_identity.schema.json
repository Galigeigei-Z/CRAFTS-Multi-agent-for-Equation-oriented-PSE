{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:langgraph-idaes:nc-v5:case-identity/v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_case_id",
    "canonical_process_id",
    "native_runner_id",
    "opaque_intent_candidate_id",
    "alias_binding_sha256",
    "suite_index"
  ],
  "properties": {
    "schema_version": {
      "const": "case-identity/v5"
    },
    "suite_case_id": {
      "$ref": "#/$defs/id"
    },
    "canonical_process_id": {
      "$ref": "#/$defs/id"
    },
    "native_runner_id": {
      "$ref": "#/$defs/id"
    },
    "opaque_intent_candidate_id": {
      "$ref": "#/$defs/id"
    },
    "suite_index": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  }
}
