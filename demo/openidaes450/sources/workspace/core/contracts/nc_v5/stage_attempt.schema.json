{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:langgraph-idaes:nc-v5:stage-attempt/v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "attempt_index",
    "input_refs",
    "raw_output_ref",
    "candidate_ref",
    "report_ref",
    "outcome",
    "failure_kind",
    "started_at_utc",
    "completed_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "stage-attempt/v5"
    },
    "stage": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "attempt_index": {
      "type": "integer",
      "minimum": 0
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "raw_output_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "report_ref": {
      "$ref": "#/$defs/ref"
    },
    "outcome": {
      "enum": [
        "promoted",
        "rejected",
        "transport_failed",
        "timed_out"
      ]
    },
    "failure_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at_utc": {
      "type": "string",
      "pattern": "Z$"
    },
    "completed_at_utc": {
      "type": "string",
      "pattern": "Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "promoted"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_ref": {
            "$ref": "#/$defs/ref"
          },
          "failure_kind": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "rejected",
              "transport_failed",
              "timed_out"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "failure_kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "path",
        "file_sha256",
        "canonical_json_sha256",
        "artifact_schema_version",
        "owning_stage",
        "attempt_index",
        "visibility_class",
        "created_at_utc"
      ],
      "properties": {
        "schema_version": {
          "const": "artifact-ref/v5"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "artifact_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "owning_stage": {
          "type": "string",
          "minLength": 1
        },
        "attempt_index": {
          "type": "integer",
          "minimum": 0
        },
        "visibility_class": {
          "enum": [
            "model_visible",
            "controller_private",
            "compiler_private",
            "evaluator_only",
            "public_release"
          ]
        },
        "created_at_utc": {
          "type": "string",
          "pattern": "Z$"
        }
      }
    }
  }
}
